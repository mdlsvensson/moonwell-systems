-- The moonwell-systems knockback gate (release 4). The maintainer builds a throwaway map from this file and runs it in
-- game (CONTRIBUTING, "In-game release gate"); CONTRIBUTING lists every expected message. One footman is pushed at a
-- time, at the centre of the screen: the screen says what the next push will show, and Esc plays it. Every printed
-- line is written to CustomMapData\moonwell-systems-knockback.pld.
import "moonwell" as mw
import "moonwell.macros" as {:$FourCC}
import "wrappers.player" as Player
import "wrappers.unit" as Unit
import "wrappers.timer" as Timer
import "wrappers.trigger" as Trigger
import "wrappers.destructable" as Destructable
import "systems.scheduler" as Scheduler
import "systems.knockback" as Knockbacks

FOOTMAN = $FourCC "hfoo"
TREE = $FourCC "LTlt"
MOVE = 851986
START_X = -300

-- Every printed line, the library's own too, is kept, and `save` writes them all to
-- Documents\Warcraft III\CustomMapData\moonwell-systems-knockback.pld: a run is read from that file afterwards.
lines = {}
screenPrint = print
_G.print = (...) ->
  screenPrint ...
  parts = [tostring(select(index, ...)) for index = 1, select("#", ...)]
  lines[#lines + 1] = table.concat parts, " "
save = ->
  PreloadGenClear!
  PreloadGenStart!
  for line in *lines
    -- A Preload line keeps 259 characters: longer lines continue on the next.
    for at = 1, #line, 200
      Preload (line\sub(at, at + 199)\gsub "\"", "'")
  PreloadGenEnd "moonwell-systems-knockback.pld"
  PreloadGenClear!
say = (...) ->
  parts = {"Knockback"}
  for index = 1, select "#", ...
    parts[#parts + 1] = tostring (select index, ...)
  print table.concat parts, " "
round = (value) ->
  text = string.format "%.1f", value
  text == "-0.0" and "0.0" or text

-- The one line that stays on screen: what the next step will show, or what is showing now.
showPrompt = (text) ->
  ClearTextMessages!
  DisplayTimedTextToPlayer GetLocalPlayer!, 0, 0, 600, text

-- One thing at a time. `play` adds a step: what it shows, how many seconds it takes, and the function that shows it.
-- The screen names the next step, Esc plays it, and when its seconds are over the screen names the one after. After
-- the last step `finish` runs.
playByPlay = (owner, name) ->
  plays = {}
  play = (text, seconds, run) -> plays[#plays + 1] = {:text, :seconds, :run}
  start = (finish) ->
    index = 0
    waiting = false
    escape = Trigger.create!
    escape\registerPlayerEvent owner, EVENT_PLAYER_END_CINEMATIC
    announce = ->
      save!
      index += 1
      current = plays[index]
      if current
        waiting = true
        showPrompt "Step #{index} of #{#plays}. Press Esc, then watch: #{current.text}."
      else
        escape\destroy!
        ClearTextMessages!
        finish!
    escape\addAction ->
      if waiting
        waiting = false
        current = plays[index]
        print "#{name} step #{index} of #{#plays}: #{current.text}"
        showPrompt "Step #{index} of #{#plays}. Watch: #{current.text}."
        current.run!
        later = Timer.create!
        later\start current.seconds, false, (self) ->
          self\destroy!
          announce!
    announce!
  play, start

knockbackGate = (owner) ->
  clock = Scheduler.new!
  clock\start!
  knockbacks = Knockbacks.new clock: clock
  throughTrees = Knockbacks.new clock: clock, pathing: "terrain"
  -- Pushes a unit, and prints why the push ended and how far the unit moved.
  push = (system, number, label, unit, request) ->
    startX, startY = unit\getX!, unit\getY!
    request.onEnd = (_, reason) ->
      say number, label, reason, "moved", round(unit\getX! - startX), round(unit\getY! - startY)
    system\apply unit, request
  -- One push: a fresh footman at the same spot, the push a second later, and the footman is gone before the next
  -- step. `walking` leaves the footman unpaused and walking east from the start.
  stage = (walking, run) ->
    unit = Unit.create owner, FOOTMAN, START_X, 0, 0
    if walking
      unit\issuePointOrder "move", 600, 0
    else
      unit\setPaused true
    clock\after 1, -> run unit
    clock\after 2.8, -> unit\remove!
  play, start = playByPlay owner, "Knockback"
  local tree

  play "a footman appears left of the middle; a second later it slides east and slows to a stop", 3, ->
    stage false, (unit) ->
      push knockbacks, 1, "slide", unit, angle: 0, distance: 300, duration: 0.8, falloff: "linear"

  -- The tree stands for steps 2 and 3 only.
  play "a tree stands east of the footman; the footman is pushed at it and stops in front of it", 3, ->
    tree = Destructable.create TREE, 0, 0, 270, 1, 0
    stage false, (unit) ->
      push knockbacks, 2, "into the tree", unit, angle: 0, distance: 400, duration: 0.8

  play "the same push with terrain pathing: the footman slides through the tree", 3, ->
    stage false, (unit) ->
      push throughTrees, 3, "through the tree", unit, angle: 0, distance: 400, duration: 0.8
    clock\after 2.9, -> tree\remove!

  play "a push east is replaced at once by a push north: the footman only moves north", 3, ->
    stage false, (unit) ->
      push knockbacks, 4, "first push", unit, angle: 0, distance: 300, duration: 1
      push knockbacks, 4, "second push", unit, angle: math.pi / 2, distance: 100, duration: 0.5

  play "the footman walks east; a push north moves it sideways, and it keeps walking east", 3, ->
    stage true, (unit) ->
      push knockbacks, 5, "walker", unit, angle: math.pi / 2, distance: 150, duration: 0.5
      clock\after 0.6, -> say 5, "the walker keeps its move order", unit\getCurrentOrder! == MOVE

  start ->
    -- 6. Speed: 100 knockbacks, timed over 320 steps of a clock of their own.
    bench = Scheduler.new!
    herd = for index = 0, 99
      unit = Unit.create owner, FOOTMAN, 1700 + (index % 10) * 40, 1300 + math.floor(index / 10) * 40, 0
      unit\setPaused true
      unit
    pushed = Knockbacks.new clock: bench
    for unit in *herd
      pushed\apply unit, angle: 0, distance: 60, duration: 15
    started = os.clock!
    for _ = 1, 320
      bench\advance!
    say "6 knockbacks:", string.format("%.3f", (os.clock! - started) * 1000 / 320), "ms per step; active",
      pushed\getCount!
    pushed\dispose!
    for unit in *herd
      unit\remove!
    bench\dispose!
    knockbacks\dispose!
    throughTrees\dispose!
    clock\dispose!
    say "gate done"
    save!
    showPrompt "The knockback gate is done. Close the game."
  say "gate started"

mw.on_main ->
  start = Timer.create!
  start\start 0, false, (self) ->
    self\destroy!
    SetCameraPosition 0, 0
    knockbackGate Player.fromIndex 0
